# ---------------------------------------------------------------
# Ahadi environment. Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------

# Public URL of the app (used in SMS links, QR codes and webhook callbacks)
APP_URL=http://localhost:3000

# Database. Leave empty to use the built-in embedded Postgres (PGlite) stored in ./.data/pglite.
# For production use a real PostgreSQL / Supabase connection string.
DATABASE_URL=

# Long random string used to hash OTP codes and sign internal tokens (openssl rand -hex 32)
APP_SECRET=change-me-to-a-long-random-string

# Phone numbers / email addresses (comma separated) that become Ahadi admins when they log in
ADMIN_PHONES=0700000001
ADMIN_EMAILS=

# Secret that background job endpoints (/api/cron/*) require in the x-cron-secret header
# Built-in scheduler: runs reminders/payment checks inside the server (one long-lived server only).
# Leave false on serverless hosts and call /api/cron/* from the host's cron instead.
INTERNAL_CRON=true
CRON_SECRET=change-me-cron-secret

# ---------- WhatsApp (login codes + pledger messages) ----------
# console = print the code to the server log (development). meta = WhatsApp Business Platform (Cloud API).
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of your approved AUTHENTICATION template (with a "copy code" button), e.g. ahadi_login_code
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_API_VERSION=v21.0
# If WhatsApp cannot deliver a code, send it by SMS instead (set to false to disable)
OTP_SMS_FALLBACK=true
# TEMPORARY: show login / PIN codes on screen while WhatsApp and SMS are not connected.
# While true, ANYONE can confirm ANY phone number. Must be false before real users.
OTP_SHOW_ON_SCREEN=false
# Receipts, reminders, milestones and invites also go on WhatsApp (admin setting whatsapp_messages_enabled).
# Template names are <prefix><stage>[_warm|_calm]; run `npm run wa:templates` for the full list to submit to Meta.
WHATSAPP_TEMPLATE_PREFIX=ahadi_
# If WhatsApp refuses or later fails to deliver a message, send the SMS version (set to false to disable)
NOTIFY_SMS_FALLBACK=true
# Webhook for delivery reports and STOP replies: {APP_URL}/api/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------- Login codes by email ----------
# console = print to the server log. resend = send with Resend (https://resend.com)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Ahadi <login@yourdomain.com>

# ---------- Continue with Google ----------
# Create an OAuth client (type "Web application") in Google Cloud Console.
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- SMS (receipts, reminders, and login-code fallback) ----------
# console = print SMS to the server log (development). africastalking = send real SMS.
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---------- Payments ----------
# Comma separated list of enabled providers in priority order. "mock" works without any keys.
PAYMENT_PROVIDERS=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret

# ZengaPay (mobile money, Uganda). Adapter is NOT implemented until official docs + sandbox keys are provided.
ZENGAPAY_API_KEY=
ZENGAPAY_WEBHOOK_SECRET=
ZENGAPAY_BASE_URL=

# DPO Pay (cards + mobile money). Adapter is NOT implemented until official docs + sandbox keys are provided.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_BASE_URL=

# --- Operations (v1.22) ---
# Error alerts: an incoming-webhook URL from Slack, Microsoft Teams, Discord or Google Chat. Empty = log only.
ALERT_WEBHOOK_URL=
# Where nightly backups of the embedded database go (default .data/backups). Copy this folder off the computer.
BACKUP_DIR=
# Uptime monitors: point them at {APP_URL}/api/health (200 = healthy, 503 = problem).
